# 工具内部数据，不随项目上传
.workbuddy/

# 工作日志 / 过程性评估报告（与代码、正式文档分离，不随仓库上传）
logs/

# 按需求排除的清单文件
姚世宸_前置任务清单.md

# 第三方仿真模块 vendor（ns3-ntn-toolkit 等，已克隆但未构建/未集成）
vendor/

# Python 缓存
__pycache__/
*.py[cod]

# 仿真生成产物（输入保留可复现，产物不入库；再次运行一键再生成）
data/sim/ns3_out/
data/sim/ns3_in/
data/sim/runs/
data/sim/*.csv
data/sim/*.json
data/sim/*.png
data/sim/*.html

# 性能诊断脚本（data/sim 下临时工具，不入库）
data/sim/perf_read.py
data/sim/perf_scale.py

# Python 性能剖析二进制（不入库）
*.prof

# 调试/反汇编残留（不入库）
dbg_*.txt
